{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStateAndExemptionTags",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "ec2:DescribeInstances",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSnapshotAttribute",
        "ec2:DescribeSnapshots",
        "ec2:DescribeTags",
        "ec2:GetEbsEncryptionByDefault",
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "rds:DescribeDBClusterSnapshotAttributes",
        "rds:DescribeDBSnapshotAttributes",
        "rds:ListTagsForResource",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3BlockPublicAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutAccountPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RevokeSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:*:ec2:*:*:security-group/*"
    },
    {
      "Sid": "EbsDefaultEncryption",
      "Effect": "Allow",
      "Action": "ec2:EnableEbsEncryptionByDefault",
      "Resource": "*"
    },
    {
      "Sid": "KmsKeyRotation",
      "Effect": "Allow",
      "Action": "kms:EnableKeyRotation",
      "Resource": "arn:*:kms:*:*:key/*"
    },
    {
      "Sid": "QuarantineInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateSnapshot",
        "ec2:CreateTags",
        "ec2:ModifyInstanceAttribute",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3RequireTls",
      "Effect": "Allow",
      "Action": "s3:PutBucketPolicy",
      "Resource": "arn:*:s3:::*"
    },
    {
      "Sid": "PrivateSnapshots",
      "Effect": "Allow",
      "Action": "ec2:ModifySnapshotAttribute",
      "Resource": "arn:*:ec2:*::snapshot/*"
    },
    {
      "Sid": "RequireImdsV2",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceMetadataOptions",
      "Resource": "arn:*:ec2:*:*:instance/*"
    },
    {
      "Sid": "EncryptQueues",
      "Effect": "Allow",
      "Action": "sqs:SetQueueAttributes",
      "Resource": "arn:*:sqs:*:*:*"
    },
    {
      "Sid": "EcrScanOnPush",
      "Effect": "Allow",
      "Action": "ecr:PutImageScanningConfiguration",
      "Resource": "arn:*:ecr:*:*:repository/*"
    },
    {
      "Sid": "PrivateDbSnapshots",
      "Effect": "Allow",
      "Action": [
        "rds:ModifyDBClusterSnapshotAttribute",
        "rds:ModifyDBSnapshotAttribute"
      ],
      "Resource": [
        "arn:*:rds:*:*:cluster-snapshot:*",
        "arn:*:rds:*:*:snapshot:*"
      ]
    }
  ]
}
